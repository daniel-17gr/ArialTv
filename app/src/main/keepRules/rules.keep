# Project R8 keep rules for Arial TV (Jetpack Compose + Media3 + Jellyfin FFmpeg + OkHttp + Coil)

# Keep Media3 FFmpeg extension decoder (instantiated via reflection by DefaultRenderersFactory)
-keep class androidx.media3.decoder.ffmpeg.** { *; }
-dontwarn androidx.media3.decoder.ffmpeg.**

# Keep Media3 reflection-loaded renderers, extractors, and data sources
-keep class androidx.media3.exoplayer.** { *; }
-keep class androidx.media3.datasource.okhttp.** { *; }
-dontwarn androidx.media3.**

# Keep OkHttp / Okio internal platform helpers
-dontwarn okhttp3.**
-dontwarn okio.**
-dontwarn org.conscrypt.**
-dontwarn org.bouncycastle.**
-dontwarn org.openjsse.**

# Keep org.json models & Coil
-dontwarn coil.**
-keepattributes Signature,InnerClasses,EnclosingMethod
